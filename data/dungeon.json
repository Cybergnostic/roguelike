{
  // The dungeon: "levels" deep. The last level has no stairs down: it's where the boss lives.
  "levels": 7,
  // How monsters grow per level below the first (generic difficulty until levels get their own
  // content): +20% HP and +15% XP per level, +1 attack every 2 levels, +1 accuracy every 3,
  // +1 defence every 4, and rooms are 3% more likely to hold a squad. The character grows
  // fast with XP and gear, so the dungeon has to keep up; loot depth gating is in items.json.
  "monsterHpPerLevel": 0.2,
  "xpPerLevel": 0.15,
  "attackEveryLevels": 2,
  "accuracyEveryLevels": 3,
  "defenseEveryLevels": 4,
  "roomOccupancyPerLevel": 0.03,
  // Time. A corpse withers after "corpseWithersAfter" turns and is gone after "corpseGoneAfter"
  // (the ancient dead the history leaves don't rot further). Coming back after "calmAfter" turns,
  // everyone has settled down. While you're away monsters regain 1 HP per "turnsPerHealedHp",
  // and a camp replaces one fallen guard per "turnsPerReplacement".
  "corpseWithersAfter": 400,
  "corpseGoneAfter": 1500,
  // Hearing, in cells. You hear fighting within "hearRange", can tell its direction within
  // "hearDirectionRange" and who is fighting within "hearWhoRange"; each point of Perception adds
  // "hearPerPoint" to all three.
  "hearRange": 32,
  "hearDirectionRange": 20,
  "hearWhoRange": 8,
  "hearPerPoint": 4,
  // Sneaking. Footsteps carry "footstepNoise" cells, plus the armour's noise, minus Stealth; sneaking
  // halves that and each step takes "sneakStepTime" (100 is a normal step). A fight carries "fightNoise".
  // Enemies spot a sneaker within "sneakSight" cells (a walker, within 8.5), less half a cell per Stealth.
  // Footsteps of enemies can be heard within "hearFootsteps", plus "hearPerPoint" / 2 per Perception.
  "footstepNoise": 3,
  "fightNoise": 7,
  "sneakStepTime": 150,
  "sneakSight": 5.5,
  "hearFootsteps": 5,
  "calmAfter": 30,
  "turnsPerHealedHp": 20,
  "turnsPerReplacement": 400
}
