    { "id": "bone_knight", "faction": "undead", "role": "warrior", "rank": "elite", "maxHp": 22, "attack": 7, "defense": 3, "xp": 40, "lootDepthBonus": 1, "fearless": true, "loot": "skeleton", "risesAs": "skeleton_warrior", "abilities": ["charge"] },
    { "id": "wraith", "faction": "undead", "role": "archer", "rank": "elite", "maxHp": 14, "attack": 5, "defense": 0, "xp": 35, "range": 6, "evasion": 3, "speed": 120, "fearless": true, "abilities": ["soul_drain"] },

