{
  // Front-end only: how each kind of thing is drawn. The simulation never reads this.
  // Glyphs are single characters (or a CP437 code as a number); colours are #RRGGBB.
  // Kinds may set "rangedVerb" for their ranged attacks (default "shoots").
  "kinds": {
    "player":           { "glyph": "@", "color": "#FFFFFF" },
    "goblin_warrior":   { "glyph": "g", "color": "#6EC846" },
    "goblin_archer":    { "glyph": "g", "color": "#DCC850" },
    "goblin_shaman":    { "glyph": "g", "color": "#BE6EE6" },
    "goblin_runner":    { "glyph": "g", "color": "#5AC8DC" },
    "skeleton_warrior": { "glyph": "s", "color": "#E6E2D2" },
    "skeleton_archer":  { "glyph": "s", "color": "#B4AA8C" },
    "goblin_zombie":    { "glyph": "z", "color": "#8CA060" },
    "necromancer":      { "glyph": "N", "color": "#D090FF", "rangedVerb": "blasts" },
    "acolyte":          { "glyph": "n", "color": "#B478FF", "rangedVerb": "blasts" },
    "wolf":             { "glyph": "w", "color": "#A8A8B0" },
    "boar":             { "glyph": "b", "color": "#9A7A58" },
    "giant_spider":     { "glyph": "x", "color": "#B05050" },
    "bear":             { "glyph": "B", "color": "#A07040" },
    "bandit":           { "glyph": "r", "color": "#D08050" },
    "bandit_archer":    { "glyph": "r", "color": "#D8B070" },
    "bandit_chief":     { "glyph": "R", "color": "#E09050" },
    "peddler":          { "glyph": "p", "color": "#70E0C0" },
    "hermit":           { "glyph": "h", "color": "#70E0C0" },
    "watchman":         { "glyph": "W", "color": "#70C0E0" },
    "hunter":           { "glyph": "H", "color": "#70C0E0" },
    "villager":         { "glyph": "v", "color": "#70C0E0" },
    "bone_knight":      { "glyph": "K", "color": "#E6E2D2" },
    "wraith":           { "glyph": "W", "color": "#90A8E0", "rangedVerb": "chills" },
    "goblin_brute":     { "glyph": "G", "color": "#6EC846" },
    "goblin_captain":   { "glyph": "G", "color": "#D0C040" },
    "goblin_warlord":   { "glyph": "G", "color": "#E0A030" }
  },
  // What a fight sounds like when you can tell who's in it (front end only).
  "factionSounds": {
    "goblins": "goblins shrieking",
    "undead": "bones rattling",
    "beasts": "animals snarling",
    "bandits": "men cursing",
    "folk": "villagers shouting",
    "player": "someone fighting"
  },
  // Grunts in popups, by faction: "attack", "hurt" and "die" (front end only).
  "grunts": {
    "goblins": { "attack": ["Hrak!", "Nyah!", "Stab!"], "hurt": ["Yeep!", "Ow-ow!", "Grk!"], "die": ["Gaaah...", "Nnngk!"] },
    "undead":  { "attack": ["*clack*", "*rattle*"], "hurt": ["*crack*", "*splinter*"], "die": ["*bones fall*", "*dust*"] },
    "beasts":  { "attack": ["Grrr!", "*snap*", "Snrl!"], "hurt": ["Yip!", "*whine*"], "die": ["*whimper*"] },
    "bandits": { "attack": ["Hah!", "Have at you!"], "hurt": ["Argh!", "Damn you!"], "die": ["Tell my..."] },
    "folk":    { "attack": ["For the hamlet!", "Back!"], "hurt": ["Ow!", "Help!"], "die": ["No..."] }
  },
  // Items by id; categories are the fallback for ids not listed.
  "items": {
    "weapon":         { "glyph": ")", "color": "#C8C8D2" },
    "bow":            { "glyph": "}", "color": "#B48C5A" },
    "armor":          { "glyph": "[", "color": "#A0A0AA" },
    "potion":         { "glyph": "!", "color": "#E65A78" },
    "coins":          { "glyph": "$", "color": "#F0D250" },
    "relic":          { "glyph": "*", "color": "#E8B060" },
    "long_sword":     { "glyph": ")", "color": "#E6E6F0" },
    "chain_mail":     { "glyph": "[", "color": "#C8C8D2" }
  },
  // Corpses use this glyph, in a dimmed colour of the kind that died.
  "corpse": { "glyph": "%" },
  // "glyphs": other glyphs a cell of this tile can show. "background": the tile's own ground colour.
  "tiles": {
    "wall":       { "glyph": "#", "color": "#8C8278" },
    "floor":      { "glyph": ".", "color": "#747f86", "glyphs": [".", ".", ",", "."] },
    "lairfloor":  { "glyph": ".", "color": "#927c5b", "glyphs": [".", ","] },
    "pillar":     { "glyph": 254, "color": "#a7afb4" },
    "stairsdown": { "glyph": ">", "color": "#f1ece1", "background": "#1a2228" },
    "stairsup":   { "glyph": "<", "color": "#f1ece1", "background": "#1a2228" },
    "grass":      { "glyph": ".", "color": "#67804f", "glyphs": [".", ",", ".", "`"] },
    "road":       { "glyph": 250, "color": "#c2a473", "glyphs": [250, ":"], "background": "#1b1711" },
    "brush":      { "glyph": "\"", "color": "#8aa556" },
    "tree":       { "glyph": 5,   "color": "#4a8a5c", "glyphs": [5, 6] },
    "palisade":   { "glyph": "#", "color": "#b5804a" },
    "gateopen":   { "glyph": "'", "color": "#e0a95c" },
    "gateclosed": { "glyph": "+", "color": "#e0a95c" },
    "gatebroken": { "glyph": ":", "color": "#d29a58" },
    "cavemouth":  { "glyph": 31,  "color": "#e6ebee", "background": "#1a2228" },
    "waystone":   { "glyph": 239, "color": "#e6ebee" },
    "inscription": { "glyph": 234, "color": "#e8c98b" },
    "rubble":     { "glyph": 177, "color": "#747f86" },
    "water":      { "glyph": "~", "color": "#5aa2c0", "glyphs": ["~", 247], "background": "#0d1a22" },
    "fire":       { "glyph": "*", "color": "#ffb74d" }
  }
}
