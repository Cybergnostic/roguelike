{
  // Front-end only: how each kind of thing is drawn. The simulation never reads this.
  // Glyphs are single characters (or a CP437 code as a number); colours are #RRGGBB.
  // Kinds may set "rangedVerb" for their ranged attacks (default "shoots").
  "kinds": {
    "player":           { "glyph": "@", "color": "#FFFFFF" },
    "goblin_warrior":   { "glyph": "g", "color": "#6EC846" },
    "goblin_archer":    { "glyph": "g", "color": "#DCC850" },
    "goblin_shaman":    { "glyph": "g", "color": "#BE6EE6" },
    "goblin_runner":    { "glyph": "g", "color": "#5AC8DC" },
    "skeleton_warrior": { "glyph": "s", "color": "#E6E2D2" },
    "skeleton_archer":  { "glyph": "s", "color": "#B4AA8C" },
    "goblin_zombie":    { "glyph": "z", "color": "#8CA060" },
    "necromancer":      { "glyph": "N", "color": "#B478FF", "rangedVerb": "blasts" }
  },
  // Items by id; categories are the fallback for ids not listed.
  "items": {
    "weapon":         { "glyph": ")", "color": "#C8C8D2" },
    "bow":            { "glyph": "}", "color": "#B48C5A" },
    "armor":          { "glyph": "[", "color": "#A0A0AA" },
    "potion":         { "glyph": "!", "color": "#E65A78" },
    "coins":          { "glyph": "$", "color": "#F0D250" },
    "long_sword":     { "glyph": ")", "color": "#E6E6F0" },
    "chain_mail":     { "glyph": "[", "color": "#C8C8D2" }
  },
  // Corpses use this glyph, in a dimmed colour of the kind that died.
  "corpse": { "glyph": "%" },
  "tiles": {
    "wall":  { "glyph": "#", "color": "#8C8278" },
    "floor": { "glyph": ".", "color": "#5A5A64" },
    "lairfloor": { "glyph": 250, "color": "#7A5A9A" },
    "pillar":    { "glyph": 254, "color": "#A898B8" },
    "stairsdown": { "glyph": ">", "color": "#F0E68C" },
    "stairsup":   { "glyph": "<", "color": "#F0E68C" },
    "grass":      { "glyph": ".", "color": "#5A8A4A" },
    "road":       { "glyph": 176, "color": "#A08A64" },
    "brush":      { "glyph": 37,  "color": "#3F8A3A" },
    "tree":       { "glyph": 5,   "color": "#2F6E35" },
    "palisade":   { "glyph": "#", "color": "#9A6A3A" },
    "gateopen":   { "glyph": "/", "color": "#C89A5A" },
    "gateclosed": { "glyph": "+", "color": "#C89A5A" },
    "cavemouth":  { "glyph": ">", "color": "#B0A090" }
  }
}
