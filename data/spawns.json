{
  // Level population. Each room except the player's start gets a squad with
  // probability "roomOccupancy"; the squad template is picked by weight.
  // Each member line adds between min and max of that monster (inclusive),
  // each one only with probability "chance" (default 1).
  // "minDepth"/"maxDepth" (squads and lairs): the dungeon levels where it can appear (default all).
  "roomOccupancy": 0.6,
  // Chance for each room to have one item lying on the floor, from the "floor" loot table.
  "floorItemChance": 0.35,
  // No squad spawns in a room that comes within this many steps (walking) of the
  // player's start, so the first fight isn't on turn 1.
  "safeStartDistance": 15,
  "squads": [
    {
      // Only the history places these (a plague level): minDepth 99 keeps them out of the normal draw.
      "name": "the sickened",
      "faction": "undead",
      "weight": 1,
      "minDepth": 99,
      "members": [ { "monster": "goblin_zombie", "min": 2, "max": 3 } ]
    },
    {
      // The first level's goblins: a scouting party, smaller than the bands that come later.
      "name": "goblin scouts",
      "faction": "goblins",
      "weight": 3,
      "maxDepth": 2,
      "members": [
        { "monster": "goblin_warrior", "min": 1, "max": 3 },
        { "monster": "goblin_archer", "min": 0, "max": 1 }
      ]
    },
    {
      // Also what the warren musters below the first level.
      "name": "goblin war band",
      "faction": "goblins",
      "weight": 3,
      "minDepth": 2,
      "members": [
        { "monster": "goblin_warrior", "min": 2, "max": 4 },
        { "monster": "goblin_archer", "min": 0, "max": 2 },
        { "monster": "goblin_shaman", "min": 0, "max": 1, "chance": 0.3 },
        { "monster": "goblin_runner", "min": 0, "max": 1, "chance": 0.5 }
      ]
    },
    {
      "name": "skeleton patrol",
      "faction": "undead",
      "weight": 2,
      "minDepth": 2,
      "members": [
        { "monster": "skeleton_warrior", "min": 2, "max": 3 },
        { "monster": "skeleton_archer", "min": 0, "max": 1 }
      ]
    },
    {
      "name": "goblin war party",
      "faction": "goblins",
      "weight": 2,
      "minDepth": 4,
      "members": [
        { "monster": "goblin_captain", "min": 1, "max": 1 },
        { "monster": "goblin_brute", "min": 0, "max": 1, "chance": 0.5 },
        { "monster": "goblin_warrior", "min": 3, "max": 5 },
        { "monster": "goblin_archer", "min": 1, "max": 3 },
        { "monster": "goblin_shaman", "min": 1, "max": 1 },
        { "monster": "goblin_runner", "min": 0, "max": 1, "chance": 0.5 }
      ]
    },
    {
      // Between the war bands and the war parties: a small squad, but it answers to someone.
      "name": "goblin vanguard",
      "faction": "goblins",
      "weight": 2,
      "minDepth": 3,
      "maxDepth": 5,
      "members": [
        { "monster": "goblin_captain", "min": 1, "max": 1 },
        { "monster": "goblin_warrior", "min": 2, "max": 3 },
        { "monster": "goblin_archer", "min": 1, "max": 2 }
      ]
    },
    {
      "name": "skeleton file",
      "faction": "undead",
      "weight": 2,
      "minDepth": 4,
      "maxDepth": 5,
      "members": [
        { "monster": "bone_knight", "min": 1, "max": 1 },
        { "monster": "skeleton_warrior", "min": 2, "max": 3 },
        { "monster": "skeleton_archer", "min": 1, "max": 1 }
      ]
    },
    {
      "name": "skeleton cohort",
      "faction": "undead",
      "weight": 2,
      "minDepth": 6,
      "members": [
        { "monster": "bone_knight", "min": 0, "max": 1, "chance": 0.5 },
        { "monster": "wraith", "min": 0, "max": 1, "chance": 0.3 },
        { "monster": "skeleton_warrior", "min": 3, "max": 4 },
        { "monster": "skeleton_archer", "min": 1, "max": 2 }
      ]
    }
  ],
  // Unique squads with a home, placed before the random ones; each takes the free room
  // farthest (walking) from the player's start, and waits there when idle.
  //   "zone": the place's name, announced when the player walks in.
  //   "architecture": how the room is rebuilt ("tower": dark flagstones, pillars that block sight).
  //   "leash": how far (walking) from home the squad will go; it holds the border instead.
  //   "corpses": remains lying in the lair from the start (raisable once he's roused).
  //   "muster": while the lair stands, send out a new squad (a template above) every
  //   "every" turns, as long as the faction has fewer than "max" squads roaming.
  // Lairs are placed as far as possible from the start and from each other.
  "lairs": [
    {
      // The bottom of everything: the necromancer himself, on the last level.
      "name": "the necromancer's court",
      "faction": "undead",
      "weight": 0,
      "minDepth": 7,
      "zone": "the necromancer's crypt",
      "architecture": "crypt",
      "leash": 18,
      "corpses": [
        { "monster": "skeleton_warrior", "count": 3 },
        { "monster": "skeleton_archer", "count": 2 }
      ],
      "members": [
        { "monster": "necromancer", "min": 1, "max": 1 },
        { "monster": "bone_knight", "min": 2, "max": 2 },
        { "monster": "wraith", "min": 1, "max": 1 },
        { "monster": "skeleton_archer", "min": 1, "max": 1 }
      ]
    },
    {
      // On the first level he is still gathering strength: a small court, few bones to raise.
      "name": "the acolyte's court",
      "faction": "undead",
      "weight": 0,
      "maxDepth": 1,
      "zone": "the acolyte's shrine",
      "architecture": "tower",
      "leash": 12,
      "corpses": [
        { "monster": "skeleton_warrior", "count": 1 }
      ],
      "members": [
        { "monster": "acolyte", "min": 1, "max": 1 },
        { "monster": "skeleton_warrior", "min": 1, "max": 1 }
      ]
    },
    {
      "name": "the acolyte's court",
      "faction": "undead",
      "weight": 0,
      "minDepth": 2,
      "maxDepth": 6,
      "zone": "the acolyte's shrine",
      "architecture": "tower",
      "leash": 12,
      "corpses": [
        { "monster": "skeleton_warrior", "count": 2 },
        { "monster": "skeleton_archer", "count": 1 }
      ],
      "members": [
        { "monster": "acolyte", "min": 1, "max": 1 },
        { "monster": "skeleton_warrior", "min": 1, "max": 1 },
        { "monster": "skeleton_archer", "min": 1, "max": 1 }
      ]
    },
    {
      // On the first level the warren is young: it sends out scouts, more slowly.
      "name": "the goblin warren",
      "faction": "goblins",
      "weight": 0,
      "maxDepth": 1,
      "zone": "the goblin warren",
      "leash": 10,
      "members": [
        { "monster": "goblin_shaman", "min": 1, "max": 1 },
        { "monster": "goblin_warrior", "min": 1, "max": 1 },
        { "monster": "goblin_archer", "min": 1, "max": 1 }
      ],
      "muster": { "squad": "goblin scouts", "every": 150, "max": 2 }
    },
    {
      "name": "the goblin warren",
      "faction": "goblins",
      "weight": 0,
      "minDepth": 2,
      "maxDepth": 3,
      "zone": "the goblin warren",
      "leash": 10,
      "members": [
        { "monster": "goblin_shaman", "min": 1, "max": 1 },
        { "monster": "goblin_warrior", "min": 1, "max": 1 },
        { "monster": "goblin_archer", "min": 1, "max": 1 }
      ],
      "muster": { "squad": "goblin war band", "every": 100, "max": 3 }
    },
    {
      "name": "the goblin warren",
      "faction": "goblins",
      "weight": 0,
      "minDepth": 4,
      "maxDepth": 5,
      "zone": "the goblin warren",
      "leash": 10,
      "members": [
        { "monster": "goblin_warlord", "min": 1, "max": 1 },
        { "monster": "goblin_shaman", "min": 1, "max": 1 },
        { "monster": "goblin_warrior", "min": 1, "max": 1 },
        { "monster": "goblin_archer", "min": 1, "max": 1 }
      ],
      "muster": { "squad": "goblin war band", "every": 100, "max": 3 }
    }
  ]
}
