{
  // How an attack resolves:
  // 1. Hit chance = baseHitChance + hitChancePerPoint x (attacker accuracy - target evasion),
  //    clamped to [minHitChance, maxHitChance]. Shooting an adjacent target costs pointBlankPenalty
  //    accuracy (bows are for range).
  // 2. On a hit: damage = roll 1..attack, minus a random 0..defence absorbed by armour,
  //    but at least minDamage. Armour softens blows; it never makes anyone untouchable.
  // 3. A second weapon in the off hand strikes too, at offHandAccuracy and offHandAttack.
  "offHandAccuracy": -4,
  "offHandAttack": -1,
  // How a squad sizes up the player: (its total HP x total attack, softened by the player's armour) over
  // (the player's HP x best attack). Anyone else already fighting the player counts on the squad's side.
  // Above boldAbove it swarms; below waryBelow it hangs back; below terrifiedBelow it runs. If the player
  // has a bow and it's within allInWithin cells, running is pointless, so it charges instead.
  // pleaChance: how often a hopeless squad that talks begs at all. secretChance: how often a beggar has
  // something to trade, and then only if there's still something on the level the player hasn't found.
  "pleaChance": 0.35,
  "secretChance": 0.3,
  "boldAbove": 1.2,
  "waryBelow": 0.6,
  "terrifiedBelow": 0.2,
  "allInWithin": 3,
  "baseHitChance": 75,
  "hitChancePerPoint": 5,
  "minHitChance": 5,
  "maxHitChance": 95,
  "pointBlankPenalty": 4,
  "minDamage": 1
}
