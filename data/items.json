{
  // Item types. category: weapon | bow | armor | potion | coins | relic.
  // Weapons and bows: "attackTime" is how long a blow takes (100 = one ordinary turn, lower is quicker),
  // "accuracy" adds to the chance of hitting in melee, "dualWield" lets a second one go in the off hand.
  // Armor: "noise" is how many cells farther your footsteps carry when you wear it.
  // "moveTime": how long a step takes (100 is normal; attacks aren't affected). "arrowGuard": extra armour against
  // missiles. "brace": extra armour if you didn't step last turn, and you hit back at the first attacker each turn.
  // "counter": percent chance of hitting back at the first attacker each turn while braced.
  // "stagger" (weapons): percent chance a melee hit costs the target its next action; Strength adds to it.
  // "menace" (any gear): how much more dangerous you look to monsters sizing you up, in percent.
  // weapon/bow "attack" and armor "defense" are bonuses; +X enchantment adds on top.
  // "minDepth": the shallowest dungeon level where it can be generated (default 1). Good gear
  // waits deeper down; monsters with "lootDepthBonus" (bosses, old dwarven dead) drop from deeper.
  "items": [
    { "id": "dagger",          "name": "dagger",          "category": "weapon", "attack": 2, "attackTime": 75, "dualWield": true },
    { "id": "short_sword",     "name": "short sword",     "category": "weapon", "attack": 4, "accuracy": 1 },
    { "id": "long_sword",      "name": "long sword",      "category": "weapon", "attack": 6, "attackTime": 130, "menace": 10, "stagger": 20, "minDepth": 2 },
    { "id": "short_bow",       "name": "short bow",       "category": "bow",    "attack": 3, "range": 6, "attackTime": 80 },
    { "id": "long_bow",        "name": "long bow",        "category": "bow",    "attack": 5, "range": 8, "attackTime": 130, "minDepth": 2 },
    { "id": "leather_armor",   "name": "leather armor",   "category": "armor",  "defense": 1, "noise": 1 },
    { "id": "chain_mail",      "name": "chain mail",      "category": "armor",  "defense": 3, "noise": 3, "moveTime": 110, "arrowGuard": 1, "brace": 1, "counter": 15, "menace": 15, "minDepth": 3 },
    { "id": "plate_armor",     "name": "plate armor",     "category": "armor",  "defense": 5, "noise": 5, "moveTime": 125, "arrowGuard": 3, "brace": 2, "counter": 30, "menace": 35, "minDepth": 4 },
    { "id": "healing_potion",  "name": "potion of healing", "plural": "potions of healing", "category": "potion", "heal": 15 },
    // Money: goes in the purse when picked up. "min"/"max" in a loot table say how many.
    { "id": "gold",            "name": "gold coin",       "plural": "gold coins", "category": "coins" },
    // Carried for its own sake (see "objective" in surface.json).
    { "id": "reliquary",       "name": "bronze reliquary", "category": "relic" }
  ],

  // Rolled for every generated weapon, bow or armor: the classic +X (negative = cursed).
  // "minDepth" keeps the big pluses for deeper levels.
  "enchantments": [
    { "value": -1, "weight": 5 },
    { "value": 0,  "weight": 65 },
    { "value": 1,  "weight": 20 },
    { "value": 2,  "weight": 8, "minDepth": 2 },
    { "value": 3,  "weight": 2, "minDepth": 4 }
  ],

  // Loot tables: one entry is picked by weight; "item": null means nothing.
  "lootTables": {
    "goblin": [
      { "item": null,             "weight": 45 },
      { "item": "gold",           "weight": 15, "min": 2, "max": 6 },
      { "item": "healing_potion", "weight": 3 },
      { "item": "dagger",         "weight": 8 },
      { "item": "short_sword",    "weight": 5 },
      { "item": "short_bow",      "weight": 4 },
      { "item": "leather_armor",  "weight": 4 },
      { "item": "long_bow",       "weight": 1 }
    ],
    // Skeletons still carry the old dwarven gear they were buried with.
    "skeleton": [
      { "item": null,            "weight": 50 },
      { "item": "gold",          "weight": 10, "min": 3, "max": 8 },
      { "item": "long_sword",    "weight": 8 },
      { "item": "chain_mail",    "weight": 5 },
      { "item": "short_sword",   "weight": 5 },
      { "item": "long_bow",      "weight": 2 }
    ],
    // The necromancer always leaves something worth the fight.
    "necromancer": [
      { "item": "long_sword",     "weight": 3 },
      { "item": "chain_mail",     "weight": 3 },
      { "item": "long_bow",       "weight": 2 },
      { "item": "healing_potion", "weight": 2 }
    ],
    "bandit": [
      { "item": null,             "weight": 35 },
      { "item": "gold",           "weight": 35, "min": 5, "max": 15 },
      { "item": "healing_potion", "weight": 6 },
      { "item": "dagger",         "weight": 8 },
      { "item": "short_sword",    "weight": 6 },
      { "item": "short_bow",      "weight": 5 },
      { "item": "leather_armor",  "weight": 5 }
    ],
    "floor": [
      { "item": "healing_potion", "weight": 6 },
      { "item": "dagger",         "weight": 8 },
      { "item": "short_sword",    "weight": 8 },
      { "item": "long_sword",     "weight": 4 },
      { "item": "short_bow",      "weight": 6 },
      { "item": "long_bow",       "weight": 2 },
      { "item": "leather_armor",  "weight": 8 },
      { "item": "chain_mail",     "weight": 3 },
      { "item": "plate_armor",    "weight": 1 }
    ]
  }
}
