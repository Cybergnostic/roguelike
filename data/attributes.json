{
  // The six attributes (D&D style; to be revisited). modifier = floor((score - 10) / 2), so 10-11
  // is +0, 12-13 is +1, 8-9 is -1. "perModifier" is what each modifier point adds to derived stats.
  // Fractions add up before rounding down. Stats: maxHp, meleeAttack, rangedAttack, defense,
  // range, regen (fewer turns per HP), potionHealing (%), xpGain (%), accuracy, evasion
  // (each point of accuracy/evasion is 5% hit chance, see combat.json).
  "attributes": [
    { "id": "str", "name": "Strength",     "description": "Melee damage.",
      "perModifier": { "meleeAttack": 1, "stagger": 5 } },
    { "id": "dex", "name": "Dexterity",    "description": "Hit more often, dodge more often, shoot a little harder, move quietly.",
      "perModifier": { "accuracy": 1, "evasion": 1, "rangedAttack": 0.5, "stealth": 1 } },
    { "id": "con", "name": "Constitution", "description": "Hit points.",
      "perModifier": { "maxHp": 3 } },
    { "id": "int", "name": "Intelligence", "description": "Learn faster, and channel more power into spells.",
      "perModifier": { "xpGain": 10, "magic": 1 } },
    { "id": "wis", "name": "Wisdom",       "description": "Recover faster, treat wounds, and tell what you hear.",
      "perModifier": { "regen": 1, "potionHealing": 10, "perception": 1 } },
    // Nothing to persuade yet: Charisma will matter once you can talk to factions.
    { "id": "cha", "name": "Charisma",     "description": "Dealing with factions (not in the game yet)." }
  ],
  // Buying +1 to any attribute: the first costs baseCost XP, each later one costPerRaise more.
  "raise": { "baseCost": 30, "costPerRaise": 15, "maxScore": 20 }
}
