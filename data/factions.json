{
  // Factions and how they feel about each other.
  // Members of the same faction are always allied; pairs not listed are neutral.
  // "player" must exist.
  // "raid": standing orders. Every "every" turns the faction sends its nearest idle squad
  // against a lair of the "against" faction (which it must be hostile to).
  "factions": [
    { "id": "player", "name": "you" },
    // The goblins hate the tower. Their dead feed the necromancer, so each raid makes him stronger.
    { "id": "goblins", "name": "the goblins", "raid": { "every": 100, "against": "undead" },
      "taunts": ["Fresh meat! Spread out, boys!", "Alone down here? Bad luck, that.", "Drop your purse and we'll make it quick!"],
      "pleas": ["Wait! Wait, big one! We know things! Don't kill!", "Mercy! Spare us and we tell you what's down here!"] },
    { "id": "undead", "name": "the undead" },
    // Out in the wider valley.
    { "id": "beasts", "name": "wild animals" },
    { "id": "bandits", "name": "the bandits",
      "taunts": ["Nowhere to run, friend. Surround 'em.", "Your coin or your throat."],
      "pleas": ["Enough! Enough! I've a family! I'll tell you where the good stuff is!"] },
    { "id": "folk", "name": "the hamlet folk" }
  ],
  "relations": [
    { "a": "player", "b": "goblins", "relation": "hostile" },
    { "a": "player", "b": "undead", "relation": "hostile" },
    { "a": "goblins", "b": "undead", "relation": "hostile" },
    { "a": "player", "b": "beasts", "relation": "hostile" },
    { "a": "player", "b": "bandits", "relation": "hostile" },
    { "a": "folk", "b": "bandits", "relation": "hostile" },
    { "a": "folk", "b": "beasts", "relation": "hostile" },
    { "a": "folk", "b": "undead", "relation": "hostile" }
  ]
}
