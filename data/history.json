{
  // The site's past, rolled once per seed before any map is built. It decides what the levels
  // are like, what lies where, and what the inscribed stones tell.
  // "mineDepth": [min, max] how many dungeon levels the dwarves dug.
  "mineDepth": [3, 5],
  // How the mine fell (on a level from 2 down to the bottom of the mine). "kind": war | collapse.
  "falls": [
    { "kind": "war",      "weight": 1 },
    { "kind": "collapse", "weight": 1 },
    { "kind": "plague",   "weight": 1 }
  ],
  // Who holds the camp on the road now. "weights": how likely each is, given how the mine fell.
  // "price"/"turns" replace the toll in surface.json. "remove"/"add" change the groups there.
  // "story" is what the stone says; "{tribe}" is the tribe's name.
  "tribes": [
    { "id": "tollkeepers", "weights": { "war": 1, "collapse": 2, "plague": 1 },
      "story": "When the dwarves were gone, the {tribe} goblins took the valley road, and they live off what they charge to pass." },
    { "id": "warband", "weights": { "war": 3, "collapse": 1, "plague": 1 }, "price": 40, "turns": 80,
      "add": [
        { "group": "gate sentries", "monster": "goblin_warrior", "at": [43, 7] },
        { "group": "camp reserve",  "monster": "goblin_warrior", "at": [38, 5] },
        { "group": "front patrol",  "monster": "goblin_archer",  "at": [41, 11] }
      ],
      "story": "The {tribe} goblins came up the valley for war and never left. They hold the road in strength, and passage is dear." },
    { "id": "remnant", "weights": { "war": 0, "collapse": 2, "plague": 3 }, "price": 10, "turns": 250,
      "remove": [
        { "group": "camp reserve", "monster": "goblin_shaman" },
        { "group": "front patrol", "monster": "goblin_archer" }
      ],
      "story": "Only a remnant of the {tribe} goblins still holds the road. There are few of them now, and they take what they can get." }
  ],
  // Old timber props stand in this many rooms of every mine level: cover, and a sign of who dug here.
  "workingsRooms": 2,
  // War: the dead lie where they fell, and some of them still walk.
  "battlefield": {
    "corpses": [ { "monster": "skeleton_warrior", "count": 8 }, { "monster": "goblin_warrior", "count": 4 } ],
    "squad": "skeleton patrol",
    "squads": 2
  },
  // Plague: the sick got up again. Slow, and hard to put down.
  "plague": {
    "corpses": [ { "monster": "goblin_zombie", "count": 6 } ],
    "squad": "the sickened",
    "squads": 3
  },
  // Collapse: fallen rock in this many rooms, and what the miners left behind.
  "collapse": { "rooms": 4, "items": 3 },
  // The founder's own item, left on the level where the mine fell: "items" by weight, always this good.
  "heirloom": {
    "items": [
      { "item": "long_sword", "weight": 3 },
      { "item": "long_bow",   "weight": 1 },
      { "item": "chain_mail", "weight": 2 }
    ],
    "enchantment": 2,
    "affixes": [2, 3],
    "special": true
  },
  // XP for reading an inscribed stone.
  "loreXp": 20,
  "names": {
    "tribeFirst":   ["Black", "Broken", "Cracked", "Red", "Rot", "Split", "Yellow"],
    "tribeLast":    ["Ear", "Eye", "Hand", "Knife", "Nail", "Tongue", "Tooth"],
    "founderFirst": ["Bor", "Dur", "Gar", "Hel", "Kor", "Mar", "Rag", "Tor", "Ulf", "Vor"],
    "founderLast":  ["dan", "gun", "mek", "orn", "rak", "sten", "ulf", "var"],
    "clanFirst":    ["Ash", "Deep", "Grey", "Iron", "Long", "Red", "Stone", "Tin"],
    "clanLast":     ["beard", "delve", "fist", "hand", "hewer", "shaft"],
    "necromancerFirst": ["Asha", "Ilva", "Morta", "Nessa", "Oren", "Sevra", "Tobin", "Veshna"],
    "necromancerLast":  ["the Pale", "the Unburied", "of the Ninth Bell", "Grave-Singer", "Ash-Handed"],
    "heirloomFirst": ["Ember", "Grudge", "Last", "Oath", "Silent", "Widow"],
    "heirloomLast":  ["Bearer", "Keeper", "Maker", "Oath", "Song", "Word"]
  }
}
