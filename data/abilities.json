{
  // What elites and bosses can do beyond hitting things. Monsters list these by id in "abilities"
  // (monsters.json, elites.json). "kind" is the rule:
  //   charge  rush up to "range" cells to a spot next to the enemy and strike
  //   warcry  put "amount" morale back into the squad
  //   volley  shoot the enemy "count" times at once
  //   blink   vanish to a spot up to "range" cells away, when someone is adjacent
  //   summon  call up "count" of "monster", bound to the summoner
  //   drain   a ranged attack that heals the attacker by "amount" if it lands
  //   frighten  squads within "range" lose "amount" morale
  //   bash    a melee blow, "amount" harder, that always staggers
  //   pin     a bow shot that always staggers
  //   vanish  jump up to "range" cells away and go unseen for "amount" turns
  //   bolt    a spell at "range": strength "power"
  //   heal    restore "power" hit points
  // "power" and healing grow with the Magic stat. "you" is the player's own wording.
  // "verb" finishes the sentence "The bone knight ... you!" in the log.
  // "windUp" (monsters): announced a turn ahead ("warning" finishes "The bear ..."), and delivered on its
  // next action only if it still can: step out of reach, or stagger it, and the blow is spoiled.
  "abilities": [
    { "id": "charge",       "kind": "charge", "cooldown": 6,  "range": 4, "verb": "charges", "windUp": true, "warning": "lowers its head to charge" },
    { "id": "heavy_blow",   "kind": "bash",   "cooldown": 5,  "amount": 4, "verb": "brings a crushing blow down on", "windUp": true, "warning": "raises its weapon high" },
    { "id": "warcry",       "kind": "warcry", "cooldown": 12, "amount": 30, "verb": "bellows a war cry" },
    { "id": "volley",       "kind": "volley", "cooldown": 5,  "count": 2, "verb": "looses a volley at" },
    { "id": "blink",        "kind": "blink",  "cooldown": 6,  "range": 7, "verb": "vanishes in a twist of shadow" },
    { "id": "raise_guard",  "kind": "summon", "cooldown": 14, "monster": "skeleton_warrior", "count": 2, "verb": "calls the dead up through the floor" },
    { "id": "soul_drain",   "kind": "drain",  "cooldown": 4,  "amount": 6, "verb": "drinks the life from" },

    // The player's skills (skills.json grants these).
    { "id": "war_cry",      "kind": "frighten", "cooldown": 30, "range": 8, "amount": 40, "verb": "roars", "you": "roar a challenge", "name": "War Cry" },
    { "id": "crushing_blow","kind": "bash",   "cooldown": 14,  "amount": 3, "verb": "smashes", "you": "bring a crushing blow down on" },
    { "id": "hunters_volley","kind": "volley","cooldown": 7,  "count": 2, "verb": "looses a volley at", "you": "loose a volley at", "name": "Rapid Shot", "description": "Two arrows at once." },
    { "id": "pinning_shot", "kind": "pin",    "cooldown": 10, "amount": 30, "turns": 2, "verb": "pins", "you": "pin", "name": "Pinning Shot" },
    // Class skills (COMBAT_AND_MAGIC.md §3). "time": how long it takes (100 = a turn; 0 = no time).
    { "id": "shove",        "kind": "shove",  "cooldown": 4, "verb": "shoves", "you": "shove", "name": "Shove", "description": "Push an enemy back; into a wall or another, both reel." },
    { "id": "careful_aim",  "kind": "aimedShot", "cooldown": 3, "amount": 40, "power": 3, "time": 150, "verb": "takes careful aim at", "you": "take careful aim at", "name": "Careful Aim", "description": "A slow shot: +3 accuracy, +40% damage." },
    { "id": "suppressive_fire", "kind": "suppress", "cooldown": 15, "count": 3, "amount": 2, "turns": 3, "verb": "covers the ground around", "you": "train your bow on the ground around", "name": "Suppressive Fire", "description": "For 3 turns, shoot whoever steps within 2 of the target (3 shots); they lose nerve." },
    { "id": "disengage",    "kind": "disengage", "cooldown": 6, "verb": "falls back and shoots", "you": "fall back and shoot", "name": "Disengage", "description": "Step back from an enemy and shoot it, in one action." },
    { "id": "mark_prey",    "kind": "markPrey", "cooldown": 10, "range": 12, "turns": 30, "amount": 20, "power": 40, "time": 0, "verb": "marks", "you": "mark", "name": "Mark Prey", "description": "No time: +20% damage on it for 30 turns; you always see it." },
    { "id": "tumble",       "kind": "tumble", "cooldown": 5, "verb": "tumbles past", "you": "tumble past", "name": "Tumble", "description": "Slip past an adjacent enemy to the cell behind it." },
    { "id": "throw_stone",  "kind": "distract", "cooldown": 4, "range": 8, "amount": 4, "verb": "throws a stone past", "you": "toss a stone past", "name": "Throw Stone", "description": "It clatters beyond the target; squads near it go to look." },
    { "id": "smoke",        "kind": "smoke", "cooldown": 25, "range": 1, "turns": 8, "verb": "vanishes in a cloud of smoke", "you": "break a smoke pot", "name": "Smoke", "description": "A cloud around you for 8 turns that nobody sees through." },
    { "id": "vanish",       "kind": "vanish", "cooldown": 25, "range": 7, "amount": 4, "verb": "vanishes", "you": "vanish in a blink", "name": "Vanish" },
    { "id": "shadow_strike","kind": "charge", "cooldown": 6, "range": 6, "verb": "strikes from the shadows at", "you": "step through the shadows at", "name": "Shadow Strike" },
    // The Mystic: power over the spirit, not fire or ice.
    { "id": "word_of_power", "kind": "word", "cooldown": 2, "range": 7, "power": 4, "verb": "speaks a word of power at", "you": "speak a word of power at", "name": "Word of Power", "description": "Strikes at range through any armour." },
    { "id": "hex",          "kind": "hex",   "cooldown": 8, "range": 7, "amount": 20, "turns": 10, "verb": "hexes", "you": "hex", "name": "Hex", "description": "+20% damage taken, -20% dealt, 10 turns." },
    { "id": "spirit_blade", "kind": "spiritBlade", "cooldown": 14, "amount": 2, "turns": 8, "verb": "wreathes its blade in pale fire", "you": "wake the spirit in your blade", "name": "Spirit Blade", "description": "+2 melee through armour, 8 turns." },
    { "id": "aegis",        "kind": "aegis", "cooldown": 20, "power": 8, "turns": 10, "verb": "is wrapped in a ward", "you": "raise a ward of will", "name": "Aegis", "description": "Soaks 8 + Magic damage for 10 turns." },
  ]
}
