      { "id": "mend", "name": "Mend", "description": "Close your own wounds.",
        "ranks": 1, "cost": [50], "ability": "mend" },
      { "id": "life_drain", "name": "Life Drain", "description": "Take their strength for your own.",
        "ranks": 1, "cost": [70], "ability": "life_drain" }
