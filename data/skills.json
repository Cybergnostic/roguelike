        "grants": [ { "rank": 2, "special": "stances_2" }, { "rank": 3, "special": "stance_free" } ],
        "rankText": ["Aggressive +30% damage, -2 armour; Guarded +2 armour, strike back the first attacker", "Aggressive +40%; Guarded +3 armour", "changing stance takes no time"] },
      { "id": "hold_the_line", "name": "Hold the Line", "description": "Stand your ground: armour, a steady footing, and blows for those slipping past.",
