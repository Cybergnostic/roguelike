        "grants": [ { "rank": 2, "special": "slip_away" }, { "rank": 3, "ability": "shadow_strike" }, { "rank": 3, "special": "from_shadows" } ],
        "rankText": ["Vanish: jump away and go unseen for a few turns", "those who lose sight of you give up sooner", "Shadow Strike; blows from hiding catch them unaware"] }
    ]},
    { "id": "rites", "name": "Old Rites", "skills": [
      { "id": "cinder_bolt", "name": "Cinder Bolt", "description": "Burn someone from afar. Each rank adds to your Magic.",
