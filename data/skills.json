        "grants": [ { "rank": 2, "special": "intercept" }, { "rank": 3, "special": "unyielding" } ],
        "rankText": ["standing still: +1 armour, strike back more, can't be staggered", "an enemy slipping past you takes a blow", "being surrounded gives them no edge"] },
      { "id": "breakthrough", "name": "Breakthrough", "description": "Shove an enemy back; into a wall or another, both reel.",
