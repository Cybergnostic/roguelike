        "grants": [ { "rank": 2, "special": "cutthroat" }, { "rank": 3, "special": "sure_strike" } ],
        "rankText": ["Backstab: x3 on anyone caught unawares", "the fleeing and the isolated count as unaware", "such blows never miss"] },
      { "id": "evasion", "name": "Evasion", "description": "Hard to corner.",
