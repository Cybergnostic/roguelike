{
  // Skills bought with XP, grouped in trees. A class learns its own tree plus the general ones (classes.json).
  // "cost": XP per rank (one entry per rank). "requires": skills you need at least rank 1 in first.
  // "perRank": derived stat bonuses per rank (same stat names as attributes.json).
  // "special": a named ability implemented in the rules ("cleave"). "ability": an active skill it grants
  // (abilities.json). Which trees a character can learn from is set by its class (classes.json).
  "trees": [
    // ---- Class skills (COMBAT_AND_MAGIC.md §3): five per class, three ranks, each worth having from rank 1.
    // "grants": what a later rank unlocks ({ "rank": 2, "special": "..." } or "ability"). "rankText": the
    // character sheet's words for each rank.
    { "id": "warrior", "name": "Warrior", "skills": [
      { "id": "weapon_mastery", "name": "Weapon Mastery", "description": "Hit harder and surer in melee; heavy blades stagger and swing faster.",
        "ranks": 3, "cost": [40, 70, 100], "perRank": { "meleeAttack": 1, "accuracy": 1 },
        "grants": [ { "rank": 2, "special": "heavy_hands" }, { "rank": 3, "special": "swift_heavy" } ],
        "rankText": ["+1 damage and accuracy in melee", "heavy weapons stagger more often", "heavy weapons strike 15% faster"] },
      { "id": "combat_stances", "name": "Combat Stances", "description": "Fight Aggressive (harder blows, less guard) or Guarded (more armour, strike back). w changes stance.",
